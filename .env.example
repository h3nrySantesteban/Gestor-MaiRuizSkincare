# Frontend (Vite inlines these at build time — also set them in Vercel
# project settings, and redeploy after changing them, not just refresh).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo-servidor (funciones en /api). NUNCA con prefijo VITE_ — si lo tuvieran,
# Vite las metería en el bundle del cliente y quedarían públicas.
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# String que vos elegís, se configura también en el panel de Meta al dar de
# alta el webhook (Webhooks > Verify token).
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > tu app > Configuración básica > Clave secreta de la app
WHATSAPP_APP_SECRET=
# Nombre y idioma de la plantilla de recordatorio, ya aprobada por Meta
WHATSAPP_TEMPLATE_NAME=recordatorio_turno
WHATSAPP_TEMPLATE_LANG=es_AR

# String random propio (ej: openssl rand -hex 32). Protege /api/send-reminders:
# Vercel Cron manda este valor solo como "Authorization: Bearer <CRON_SECRET>"
# cuando la variable está configurada en el proyecto.
CRON_SECRET=
